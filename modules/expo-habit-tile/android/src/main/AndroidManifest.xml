<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Quick Settings Tile. Merged into the app manifest at build time.
         BIND_QUICK_SETTINGS_TILE lets the system bind the service; the
         QS_TILE intent-filter is what makes it show up in the tile editor. -->
    <service
        android:name="expo.modules.habittile.HabitTileService"
        android:exported="true"
        android:icon="@drawable/ic_habit_tile"
        android:label="Log habit"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
      <meta-data
          android:name="android.service.quicksettings.ACTIVE_TILE"
          android:value="false" />
    </service>
  </application>
</manifest>
